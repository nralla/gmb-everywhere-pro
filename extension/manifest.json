{
  "manifest_version": 3,
  "name": "GMB Everywhere Pro — Yerel SEO Aracı",
  "version": "3.1-TR",
  "description": "Google Maps DOM analizinden beslenen kapsamlı yerel SEO araç seti. GMaps'in 25+ @data-* özniteliği tersine mühendislikle çıkarıldı ve eklentiye entegre edildi.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://www.google.com/maps/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "GMB Everywhere Pro"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "img/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.google.com/maps/place/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
